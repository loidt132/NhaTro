PORT=4000
SERVICE_CATALOG_URL=http://localhost:4100

# Must match catalog-service's CATALOG_ADMIN_KEY exactly — this server uses
# it to prove admin-write requests to catalog-service come from a trusted
# backend, never from the browser.
CATALOG_ADMIN_KEY=dev-catalog-admin-key-change-me

# Sign/verify login tokens. Any non-empty string works for local dev.
JWT_SECRET=homestay-dev-secret-change-me

# Leave blank for now — server falls back to MockLockProvider until both are set.
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=

# NocoDB — run nocodb-schema.sql against this base first.
# NOCODB_PROJECT is this repo's own NocoDB base/project id (Project Settings
# → copy the id from the URL: https://.../#/nc/<PROJECT_ID>/...). With it
# set, table ids are auto-discovered by table name at startup — you only
# need to fill in a NOCODB_TABLE_* below if a table's NocoDB title doesn't
# match this repo's table names exactly (rare).
NOCODB_URL=https://your-nocodb-host
NOCODB_API_KEY=your_nocodb_api_key
NOCODB_PROJECT=your_project_base_id
NOCODB_TABLE_USERS=
NOCODB_TABLE_ROOM_TYPES=
NOCODB_TABLE_ROOMS=
NOCODB_TABLE_RATE_PLANS=
NOCODB_TABLE_STAYS=
NOCODB_TABLE_GUESTS=
NOCODB_TABLE_SERVICE_CHARGES=
NOCODB_TABLE_ROOM_TRANSFERS=
NOCODB_TABLE_LOCK_EVENTS_LOG=
NOCODB_TABLE_SETTINGS=
