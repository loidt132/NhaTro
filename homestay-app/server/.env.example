PORT=4000
SERVICE_CATALOG_URL=http://localhost:4100

# Must match catalog-service's CATALOG_ADMIN_KEY exactly — this server uses
# it to prove admin-write requests to catalog-service come from a trusted
# backend, never from the browser.
CATALOG_ADMIN_KEY=dev-catalog-admin-key-change-me

# Sign/verify login tokens. Any non-empty string works for local dev.
JWT_SECRET=homestay-dev-secret-change-me

# AES-256-GCM key encrypting guest CCCD/phone at rest in the database. 64 hex chars
# (32 bytes) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this key makes previously-encrypted guest fields unreadable.
ENCRYPTION_KEY=

# Leave blank for now — server falls back to MockLockProvider until both are set.
# After filling these in, run `npm run ttlock-register-user` once to register
# TTLOCK_USERNAME with TTLock before the app starts issuing/revoking passcodes.
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
# https://euopen.ttlock.com for EU accounts (default), https://api.ttlock.com otherwise.
TTLOCK_BASE_URL=https://euopen.ttlock.com

# PostgreSQL (Neon free tier works). On Vercel use the *pooled* connection
# string. Run `npm run migrate` once to create the tables, then `npm run seed`.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Only for the one-off `npm run import-from-nocodb`, which copies existing
# data out of the old NocoDB base. Remove once the import is done.
# NOCODB_URL=https://your-nocodb-host
# NOCODB_API_KEY=your_nocodb_api_key
# NOCODB_PROJECT=your_project_base_id
