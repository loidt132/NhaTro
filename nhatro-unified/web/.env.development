# Backend tùy chọn: `cd server && npm start`. Gọi thẳng cổng 4000 tránh Vite log ECONNREFUSED khi chưa chạy server.
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_API_ORIGIN=http://localhost:4000

# The database is never called directly from the browser — every table read/
# write goes through the backend proxy (/api/state, /api/tenants/records,
# /api/rooms/records, /api/meter-submissions...), which keeps the real
# DATABASE_URL server-side only (see server/.env.example). Nothing
# database-related belongs in this file.

# Meter photo upload + tenant login (see README section for setup steps).
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=...
# VITE_FIREBASE_APP_ID=...

# AUTH_SECRET, CORS_ORIGIN and the Cloudinary keys are backend-only config —
# set them in server/.env (local) and on the Render service (deployed),
# never here. This file is committed to git and only VITE_-prefixed values
# belong in it.
