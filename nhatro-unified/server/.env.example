# NocoDB — required. The server has no other storage (auth, room/tenant/
# invoice/payment data, and the /api/state fallback all live here); without
# these set, register/login and /api/state fail outright instead of silently
# writing to local disk (which would break on Vercel's read-only filesystem).
# Use the SAME base/token as the web app's VITE_NOCODB_URL / VITE_NOCODB_API_KEY,
# and the same table ids as its VITE_TABLE_* (just without the VITE_ prefix).
NOCODB_URL=https://your-nocodb-host
NOCODB_API_KEY=your_nocodb_api_key
NOCODB_TABLE_USERS=...
NOCODB_TABLE_ROOMS=...
NOCODB_TABLE_TENANTS=...
NOCODB_TABLE_READINGS=...
NOCODB_TABLE_INVOICES=...
NOCODB_TABLE_PAYMENTS=...
NOCODB_TABLE_RENT_PERIODS=...
NOCODB_TABLE_PAYMENT_ALLOCATIONS=...
NOCODB_TABLE_RENTAL_CONTRACTS=...
NOCODB_TABLE_DEPOSITS=...
NOCODB_TABLE_DEPOSIT_TRANSACTIONS=...
NOCODB_TABLE_DEPOSIT_REFUNDS=...
NOCODB_TABLE_SETTINGS=...
NOCODB_TABLE_METER_SUBMISSIONS=...

# Cloudinary: stores meter photos (server is stateless/serverless, no local disk).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK service account JSON (single line), used to verify the
# Phone Auth OTP ID token a tenant's browser gets from Firebase.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Tuya Cloud API. Keep the real .env file private and never put these values in the web app.
TUYA_API_ENDPOINT=https://openapi-sg.iotbing.com
TUYA_ACCESS_ID=your_tuya_access_id
TUYA_ACCESS_SECRET=your_tuya_access_secret

# Optional: comma-separated priority list. Leave unset to use the built-in defaults.
# TUYA_ENERGY_CODES=forward_energy_total,add_ele,total_forward_energy

# Set to true temporarily to print copyable cURL requests to the server console.
# These logs include a short-lived access token and signature: do not enable in production.
# TUYA_DEBUG_CURL=true
