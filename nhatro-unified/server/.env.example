# Secret used to sign auth tokens (HMAC). Set this on Render too — if it
# ever differs between environments, tokens issued by one won't verify on
# the other and users get logged out.
AUTH_SECRET=change_this_to_a_long_random_string

# Extra allowed CORS origins for the browser app(s) calling /api, beyond the
# defaults baked into index.js (localhost dev + the known production
# vercel.app domains) and the *.vercel.app preview-deployment pattern.
# Comma-separated, e.g. a custom domain: CORS_ORIGIN=https://nhatro.example.com
CORS_ORIGIN=

# PostgreSQL (Neon) — required. The server has no other storage (auth,
# room/tenant/invoice/payment data and /api/state all live here). On Vercel use
# the *pooled* connection string. Create the tables with `npm run migrate-to-neon`.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Only for the one-off `npm run migrate-to-neon`, which copies the old NocoDB
# data into Postgres. Remove once the migration is done. Table ids are the ones
# the server used to read: NOCODB_TABLE_USERS, _ROOMS, _TENANTS, _READINGS,
# _INVOICES, _PAYMENTS, _RENT_PERIODS, _PAYMENT_ALLOCATIONS, _DEPOSITS,
# _DEPOSIT_TRANSACTIONS, _DEPOSIT_REFUNDS, _RENTAL_CONTRACTS, _SETTINGS,
# _METER_SUBMISSIONS.
# NOCODB_URL=https://your-nocodb-host
# NOCODB_API_KEY=your_nocodb_api_key
# NOCODB_TABLE_USERS=...
# NOCODB_TABLE_ROOMS=...

# AES-256-GCM key encrypting tenant CCCD/phone at rest in the "tenants"
# table. 64 hex chars (32 bytes) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this key makes previously-encrypted fields unreadable.
ENCRYPTION_KEY=

# Cloudinary: stores meter photos (server is stateless/serverless, no local disk).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK service account JSON (single line), used to verify the
# Phone Auth OTP ID token a tenant's browser gets from Firebase.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Tuya Cloud API. Keep the real .env file private and never put these values in the web app.
TUYA_API_ENDPOINT=https://openapi-sg.iotbing.com
TUYA_ACCESS_ID=your_tuya_access_id
TUYA_ACCESS_SECRET=your_tuya_access_secret

# Optional: comma-separated priority list. Leave unset to use the built-in defaults.
# TUYA_ENERGY_CODES=forward_energy_total,add_ele,total_forward_energy

# Set to true temporarily to print copyable cURL requests to the server console.
# These logs include a short-lived access token and signature: do not enable in production.
# TUYA_DEBUG_CURL=true

# Vercel deployment (backend project, root dir = nhatro-unified/server):
# set every variable above in Project Settings → Environment Variables.
# CORS_ORIGIN must include the web (frontend) Vercel URL unless it matches
# https://nhatro*.vercel.app. Keep-alive pings only run under `node index.js`,
# never on Vercel.
