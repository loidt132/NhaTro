PORT=4100

# Required on every write (POST/PUT/DELETE) as the x-api-key header. Reads
# (GET) stay public. Must match the consuming app's own CATALOG_ADMIN_KEY —
# e.g. homestay-server's — exactly.
CATALOG_ADMIN_KEY=dev-catalog-admin-key-change-me

# NocoDB — run nocodb-schema.sql against this base first.
# NOCODB_PROJECT is THIS repo's own NocoDB base/project id (separate from
# homestay-server's — one NocoDB project per repo). With it set, table ids
# are auto-discovered by table name at startup — only fill in a
# NOCODB_TABLE_* below if a table's NocoDB title doesn't match exactly.
NOCODB_URL=https://your-nocodb-host
NOCODB_API_KEY=your_nocodb_api_key
NOCODB_PROJECT=your_project_base_id
NOCODB_TABLE_CATEGORIES=
NOCODB_TABLE_ITEMS=
